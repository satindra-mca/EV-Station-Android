<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <cloud-backup>

        <!-- Prevent authentication session cloud backup. -->
        <exclude
            domain="sharedpref"
            path="secure_session.xml" />

    </cloud-backup>

    <device-transfer>

        <!-- Prevent authentication session device transfer. -->
        <exclude
            domain="sharedpref"
            path="secure_session.xml" />

    </device-transfer>

</data-extraction-rules>