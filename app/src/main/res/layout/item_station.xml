<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/ev_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/ev_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Station header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Charging station icon -->
            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_green"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="&#9889;"
                android:textSize="24sp" />

            <!-- Operator and city information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStationCpoName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ev_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="HPCL" />

                <TextView
                    android:id="@+id/tvStationCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ev_text_secondary"
                    android:textSize="13sp"
                    tools:text="Bhuj, Kachchh, Gujarat" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/ev_border" />

        <!-- Station address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="@color/ev_text_secondary" />

            <TextView
                android:id="@+id/tvStationLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/ev_text_primary"
                android:textSize="14sp"
                tools:text="Adhoc Khawda Petroleum Gandhidham" />

        </LinearLayout>

        <!-- Station status and ownership type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ev_success"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Active station" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStationOwnership"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ev_text_secondary"
                android:textSize="12sp"
                tools:text="Govt." />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
