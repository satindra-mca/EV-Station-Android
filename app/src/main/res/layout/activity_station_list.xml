<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ev_background"
    android:orientation="vertical">

    <!-- Screen header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/ev_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivStationBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/desc_station_list_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/station_list_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Station count -->
    <TextView
        android:id="@+id/tvStationCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/ev_text_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="1203 charging stations found" />

    <!-- Screen content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Success state -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:listitem="@layout/item_station" />

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/layoutStationLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/ev_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/loading_stations"
                android:textColor="@color/ev_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Empty and error states -->
        <LinearLayout
            android:id="@+id/layoutStationMessage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivStationMessage"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/ev_text_secondary" />

            <TextView
                android:id="@+id/tvStationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/ev_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Unable to load charging stations" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStationRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:minWidth="120dp"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/ev_primary"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
