<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for REST API communication -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground location permissions for nearby station discovery -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ev_Station"
        tools:targetApi="31">

        <!-- Google Maps SDK API key configuration -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Login Activity -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Registation Activity -->
        <activity
            android:name=".activity.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home Activity -->
        <activity
            android:name=".activity.HomeActivity"
            android:exported="false" />

        <!-- Station List Activity -->
        <activity
            android:name=".activity.StationListActivity"
            android:exported="false" />

        <!-- Station Details Activity -->
        <activity
            android:name=".activity.StationDetailsActivity"
            android:exported="false" />

        <!-- ConnectorSelector Activity -->
        <activity
            android:name=".activity.ConnectorSelectionActivity"
            android:exported="false" />

        <!-- Google Maps Activity -->
        <activity
            android:name=".activity.MapActivity"
            android:exported="false" />

        <!-- Splash Activity -->
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Ev_Station.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.MainActivity"
            android:exported="true" />
    </application>

</manifest>